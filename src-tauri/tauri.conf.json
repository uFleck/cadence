{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cadence",
  "version": "0.1.0",
  "identifier": "dev.cadence.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cadence",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MTU3RDY0NjAwMDU3Q0MKUldUTVZ3QmdaSDBWMUp1b2NBUXB6Y1oxOERSaFRjSHRIWGtWL010QVVtSk5xQVM2Q2FMU24xWlkK",
      "endpoints": ["https://github.com/uFleck/cadence/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
